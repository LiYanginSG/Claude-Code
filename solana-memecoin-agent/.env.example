# ---------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit .env  (it is in .gitignore)
# ---------------------------------------------------------------------------

# LLM brain. Without this the agent uses its deterministic fallback strategy.
ANTHROPIC_API_KEY=sk-ant-...

# --- LIVE TRADING (leave blank unless you mean it) -------------------------
# Live mode needs ALL THREE of:
#   1. live.enabled: true          in config.yaml
#   2. LIVE_TRADING below set to the exact confirmation string
#   3. exchange API keys below
# Paper mode ignores all of these.
LIVE_TRADING=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
